SimulationBox:
  # Retained for source/spectrum components; the active volume is set below.
  anchor: [-8. pc, -8. pc, -8. pc]
  sides: [16. pc, 16. pc, 16. pc]
DensityGrid:
  type: Spherical
SphericalDensityGrid:
  centre: [0. pc, 0. pc, 0. pc]
  minimum radius: 0.05 pc
  maximum radius: 8.0 pc
  radial spacing: linear
  angular cells per face: 16
  number of radial cells: 32
  angular subgrids per face: 2
  number of radial subgrids: 4
DensityFunction:
  # HDF5DensityFunction can be selected here unchanged: spherical cells sample
  # it at their physical Cartesian midpoint, just like Cartesian cells do.
  type: Homogeneous
  density: 30. cm^-3
  temperature: 8000. K
Abundances:
  helium: 0.
TemperatureCalculator:
  do temperature calculation: false
PhotonSourceDistribution:
  type: AsciiFile
  filename: two_sources.yml
PhotonSourceSpectrum:
  type: Monochromatic
  frequency: 13.6 eV
TaskBasedIonizationSimulation:
  number of photons: 200000
  number of iterations: 5
  source copy level: 1
  output folder: output_spherical
DensityGridWriter:
  type: AsciiFile
  prefix: spherical_
CrossSections:
  type: FixedValue
  hydrogen_0: 6.3e-18 cm^2
RecombinationRates:
  type: FixedValue
  hydrogen_1: 2.7e-13 cm^3 s^-1
